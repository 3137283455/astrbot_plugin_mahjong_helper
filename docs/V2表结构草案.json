{
  "schema_version": 1,
  "status": "design_only",
  "provider": "feishu",
  "tables": [
    {
      "key": "periods",
      "name": "统计周期",
      "editable": "administrator_actions_only",
      "fields": [
        "周期ID",
        "群标识",
        "周期名称",
        "状态",
        "开始时间",
        "封存时间",
        "封存清单校验值"
      ],
      "views": [
        "当前周期",
        "历史周期"
      ]
    },
    {
      "key": "matches",
      "name": "对局明细",
      "editable": "administrator_validated_fields_only",
      "fields": [
        "对局ID",
        "群标识",
        "周期ID",
        "赛季",
        "模式",
        "精华来源编号",
        "精华时间",
        "对局时间（可空）",
        "入库时间",
        "一位昵称",
        "一位持点",
        "二位昵称",
        "二位持点",
        "三位昵称",
        "三位持点",
        "四位昵称（三麻留空）",
        "四位持点（三麻留空）",
        "原图附件",
        "确认状态",
        "备注",
        "数据版本",
        "同步状态"
      ],
      "views": [
        "当前周期三麻",
        "当前周期四麻",
        "待核对",
        "已停用",
        "历史归档"
      ],
      "validation": [
        "整局人数和顺位完整",
        "持点为最终整数持点",
        "三麻四位字段为空",
        "昵称不同且保留完整字符",
        "点数与现有规则一致；非标准总额需人工确认",
        "封存周期不可直接改写",
        "稳定ID匹配，不按行号匹配"
      ]
    },
    {
      "key": "players",
      "name": "玩家统计",
      "editable": "derived_only",
      "fields": [
        "统计ID",
        "群标识",
        "周期ID",
        "赛季",
        "模式",
        "玩家标识",
        "显示昵称",
        "场次",
        "一位次数",
        "二位次数",
        "三位次数",
        "四位次数",
        "一位率",
        "二位率",
        "三位率",
        "四位率",
        "被飞次数",
        "被飞率",
        "平均顺位",
        "平均终局持点",
        "最高终局持点",
        "最低终局持点",
        "最高记录ID",
        "最低记录ID",
        "统计版本",
        "更新时间"
      ],
      "views": [
        "三麻总览",
        "四麻总览",
        "被飞次数榜",
        "被飞率榜",
        "一位率榜",
        "二位率榜"
      ]
    },
    {
      "key": "sync_log",
      "name": "同步状态",
      "editable": "application_only",
      "fields": [
        "任务ID",
        "群标识",
        "周期ID",
        "对局ID",
        "同步方向",
        "变更版本",
        "状态",
        "重试次数",
        "最近成功时间",
        "异常说明"
      ],
      "views": [
        "待同步",
        "失败待重试",
        "最近成功"
      ]
    }
  ],
  "notes": [
    "字段由tools/setup_feishu.py创建，状态使用文本字段兼容免费版。",
    "待核对和历史归档使用对局明细的筛选视图，避免复制成两份可编辑数据。",
    "运行与双向同步规则见V2使用说明.md；实际群信息和凭证不进入公开仓库。"
  ]
}
